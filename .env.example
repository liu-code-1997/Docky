# 复制为 .env 可覆盖默认配置(可选)
# OLLAMA_BASE_URL=http://localhost:11434
# QDRANT_URL=http://localhost:6333
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=nomic-embed-text
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# CHUNK_STRATEGY=char   # M5①切分策略:char(baseline) | markdown(按标题+噪声过滤,改后需重新 ingest)
# QUERY_REWRITE=true    # M5②检索前用 LLM 扩展英文术语(缓解跨语言检索)。默认开(消融验证最有效);设 false 可关
# RERANK=false          # M5③检索后用 LLM 重排候选,会多 top_k×RERANK_FACTOR 次 LLM 调用(慢)
# RERANK_FACTOR=5       # 重排时召回 top_k×该倍数 个候选
# TOP_K=4
# EVAL_SCORER=keyword   # M4 生成层评分:keyword | llm_judge | semantic
# LLM_TEMPERATURE=0.7   # 日常问答生成温度(略高更自然)
# EVAL_TEMPERATURE=0.0  # 评估时温度(恒 0,保证结果可复现)
#
# ---- M6 agent 对话 LLM(function calling)----
# CHAT_PROVIDER=openai_compat   # openai_compat(OpenAI/DeepSeek/Groq/vLLM/Ollama) | claude
# CHAT_BASE_URL=http://localhost:11434/v1   # 换厂商只改这行 + CHAT_MODEL + CHAT_API_KEY_ENV
# CHAT_MODEL=qwen2.5:7b
# CHAT_API_KEY_ENV=OPENAI_API_KEY   # 从哪个环境变量读 key(本地 Ollama 可留空)
# CLAUDE_MODEL=claude-opus-5        # CHAT_PROVIDER=claude 时生效;ANTHROPIC_API_KEY 从环境变量读
# AGENT_MAX_STEPS=5
#
# 换厂商示例(全部只改 .env,零代码):
#   DeepSeek: CHAT_BASE_URL=https://api.deepseek.com/v1  CHAT_MODEL=deepseek-chat  CHAT_API_KEY_ENV=DEEPSEEK_API_KEY
#   OpenAI:   CHAT_BASE_URL=https://api.openai.com/v1    CHAT_MODEL=gpt-4o-mini    CHAT_API_KEY_ENV=OPENAI_API_KEY
